# Copy this file to .env (which is git-ignored) and replace every value.
#   cp .env.example .env
# docker compose reads .env automatically and refuses to start if any of
# these variables is missing.

# Password for the "postgres" user of all three PostgreSQL containers
# (user_db, book_db, loan_db). Every service reads it from this one variable.
# Note: Postgres only applies it when a volume is first initialised.
DB_PASSWORD=change-me-db-password

# HMAC key used to sign JWTs (user-service) and verify them (gateway-service).
# Both services MUST receive the same value.
# MINIMUM 32 BYTES (256 bits): the gateway's jjwt library rejects shorter keys,
# and user-service refuses to start with one.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes

# Django SECRET_KEY for user-service and book-service (sessions, CSRF, signing).
# Generate one with:  openssl rand -base64 48
DJANGO_SECRET_KEY=change-me-django-secret-key
